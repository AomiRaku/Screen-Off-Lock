#include <windows.h>

/* 程序图标，由 scripts\make-icon.ps1 生成 */
1 ICON "app.ico"

/* 应用程序清单：启用 Common Controls 6.0 视觉样式、DPI 感知与高版本兼容性声明。
   缺了这一段，Windows 会退化到 Windows 95 时代的经典控件外观。 */
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,5,1,1
PRODUCTVERSION  1,5,1,1
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 0x0804 = 简体中文，0x04b0 = Unicode */
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription",  "ScreenOff Lock"
            VALUE "FileVersion",      "Build 1511"
            VALUE "InternalName",     "ScreenOffLock"
            VALUE "OriginalFilename", "ScreenOffLock.exe"
            VALUE "ProductName",      "ScreenOff Lock"
            VALUE "ProductVersion",   "Build 1511"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
